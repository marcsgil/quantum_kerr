doi = {10.1088/1464-4266/6/5/018},
url = {https://doi.org/10.1088/1464-4266/6/5/018},
year = {2004},
month = {may},
publisher = {},
volume = {6},
number = {5},
pages = {S295},
author = {Eric Lantz and Thibaut Sylvestre and Hervé Maillotte and Nicolas Treps and Claude Fabre},
title = {Quantum fluctuations and correlations of spatial scalar or multimode vector solitons in
Kerr media},
journal = {Journal of Optics B: Quantum and Semiclassical Optics},
abstract = {We apply the Green function method to determine the global degree of squeezing and the transverse spatial distribution of quantum fluctuations of solitons in Kerr media. We show that both scalar bright solitons and multimode vector solitons experience strong squeezing on the optimal quadrature. For vector solitons, this squeezing is shown to result from an almost perfect anti-correlation between the fluctuations in the two incoherently coupled circular polarizations.}
}


